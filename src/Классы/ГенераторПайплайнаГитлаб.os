#Использовать oscript-yaml

&Пластилин(Значение = "Задача", Тип = "Массив")
Перем ЗадачиПользователя; // Массив из Произвольный

&Пластилин
Перем ФабрикаЗадач; // ФабрикаЗадач

&Пластилин
Перем ОписаниеПайплайна; // ОписаниеПайплайна

&Желудь
Процедура ПриСозданииОБъекта()
	
КонецПроцедуры

Процедура СформироватьПайплайн(ПутьКФайлу) Экспорт

	Задачи = ФабрикаЗадач.Задачи();

	ВалидироватьНуждается(Задачи);
	ВалидироватьОкружения(Задачи);

	Парсер = Новый ПарсерYaml();

	Пайплайн = Новый Соответствие();

	ДобавитьДефолты(Пайплайн);

	Стадии = Новый Массив();

	Пайплайн.Вставить("stages", Стадии);

	Если ОписаниеПайплайна.Переменные.Количество() > 0 Тогда
		Пайплайн.Вставить("variables", ОписаниеПайплайна.Переменные);
	КонецЕсли;

	Если НЕ ПустаяСтрока(ОписаниеПайплайна.ШаблонПокрытия) Тогда
		Пайплайн.Вставить("coverage", ОписаниеПайплайна.ШаблонПокрытия);
	КонецЕсли;

	Зарезервированные = Гитлаб.ЗарезервированныеСтадии();

	Для Каждого ОписаниеЗадачи Из Задачи Цикл

		Если ОписаниеЗадачи = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		// Зарезервированные стадии (.pre и т.п.) в stages не попадают,
		// но джобы с ними выводятся как обычно
		ЭтоЗарезервированная = Ложь;
		Для Каждого КлючЗначение Из Зарезервированные Цикл
			Если ОписаниеЗадачи.Стадия = КлючЗначение.Значение Тогда
				ЭтоЗарезервированная = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;

		Если НЕ ПустаяСтрока(ОписаниеЗадачи.Стадия) И НЕ ЭтоЗарезервированная Тогда
			ДобавитьВМассивБезДублей(Стадии, ОписаниеЗадачи.Стадия);
		КонецЕсли;

		ОписаниеДжобы = СформироватьДжоб(ОписаниеЗадачи);

		Пайплайн.Вставить(ОписаниеЗадачи.Наименование, ОписаниеДжобы);

	КонецЦикла;
	
	СтрокаYAML = Парсер.ЗаписатьYaml(Пайплайн);

	Сообщить(СтрокаYAML);

	ЗаписатьТекстВФайл(ПутьКФайлу, СтрокаYAML);

КонецПроцедуры

// Проверяет, что все ссылки в needs указывают на существующие джобы пайплайна
//
// Параметры:
//   Задачи - Массив из ОписаниеЗадачи - задачи пайплайна
//
Процедура ВалидироватьНуждается(Задачи)

	ВалидныеИмена = Новый Массив();

	Для Каждого ОписаниеЗадачи Из Задачи Цикл

		Если ОписаниеЗадачи = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Если НЕ ПустаяСтрока(ОписаниеЗадачи.Наименование) Тогда
			ДобавитьВМассивБезДублей(ВалидныеИмена, ОписаниеЗадачи.Наименование);
		КонецЕсли;

	КонецЦикла;

	Для Каждого ОписаниеЗадачи Из Задачи Цикл

		Если ОписаниеЗадачи = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Для Каждого ИмяНужнойДжобы Из ОписаниеЗадачи.Нуждается Цикл

			Если ВалидныеИмена.Найти(ИмяНужнойДжобы) = Неопределено Тогда
				ВызватьИсключение "Задача """ + ОписаниеЗадачи.Наименование
					+ """ ссылается в needs на несуществующую джобу """ + ИмяНужнойДжобы
					+ """. Доступные джобы: " + СтрСоединить(ВалидныеИмена, ", ");
			КонецЕсли;

		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

// Проверяет корректность окружений всех задач: имя, действие, ссылку on_stop
//
// Параметры:
//   Задачи - Массив из ОписаниеЗадачи - задачи пайплайна
//
Процедура ВалидироватьОкружения(Задачи)

	ИменаДжоб = Новый Массив();

	Для Каждого ОписаниеЗадачи Из Задачи Цикл

		Если ОписаниеЗадачи = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Если НЕ ПустаяСтрока(ОписаниеЗадачи.Наименование) Тогда
			ДобавитьВМассивБезДублей(ИменаДжоб, ОписаниеЗадачи.Наименование);
		КонецЕсли;

	КонецЦикла;

	Для Каждого ОписаниеЗадачи Из Задачи Цикл

		Если ОписаниеЗадачи = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Окружение = ОписаниеЗадачи.Окружение;

		Если НЕ ИспользуетсяОкружение(Окружение) Тогда
			Продолжить;
		КонецЕсли;

		Если ПустаяСтрока(Окружение.Имя) Тогда
			ВызватьИсключение "Задача """ + ОписаниеЗадачи.Наименование
				+ """: у окружения заполнены параметры, но не задано имя (Окружение.Имя).";
		КонецЕсли;

		Если НЕ ПустаяСтрока(Окружение.Действие) И НеДопустимоеДействие(Окружение.Действие) Тогда
			ВызватьИсключение "Недопустимое действие окружения: " + Окружение.Действие
				+ ". Допустимые значения: " + СтрСоединить(ДействияОкружения.Допустимые(), ", ");
		КонецЕсли;

		Если НЕ ПустаяСтрока(Окружение.ПриОстановке)
			И ИменаДжоб.Найти(Окружение.ПриОстановке) = Неопределено Тогда
			ВызватьИсключение "Задача """ + ОписаниеЗадачи.Наименование
				+ """ ссылается в on_stop на несуществующую джобу """ + Окружение.ПриОстановке
				+ """. Доступные джобы: " + СтрСоединить(ИменаДжоб, ", ");
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Определяет, используется ли окружение помимо имени
//
// Параметры:
//   Окружение - ОписаниеОкружения - описание окружения задачи
//
//  Возвращаемое значение:
//   Булево - Истина, если заполнен хоть один параметр кроме имени
//
Функция ИспользуетсяОкружение(Окружение)

	Возврат НЕ ПустаяСтрока(Окружение.УРЛ)
		ИЛИ НЕ ПустаяСтрока(Окружение.ПриОстановке)
		ИЛИ НЕ ПустаяСтрока(Окружение.Действие)
		ИЛИ НЕ ПустаяСтрока(Окружение.АвтоОстановка);

КонецФункции

Функция НеДопустимоеДействие(Действие)

	Для Каждого Допустимое Из ДействияОкружения.Допустимые() Цикл
		Если Допустимое = Действие Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

Процедура ДобавитьДефолты(Пайплайн)

	Дефолты = Новый Соответствие();

	Если ОписаниеПайплайна.ПередСкрипты.Количество() > 0 Тогда
		Дефолты.Вставить("before_script", ОписаниеПайплайна.ПередСкрипты);
	КонецЕсли;

	Если ОписаниеПайплайна.ПослеСкрипты.Количество() > 0 Тогда
		Дефолты.Вставить("after_script", ОписаниеПайплайна.ПослеСкрипты);
	КонецЕсли;

	Если Дефолты.Количество() > 0 Тогда
		Пайплайн.Вставить("default", Дефолты);
	КонецЕсли;

КонецПроцедуры

// <Описание функции>
//
// Параметры:
//   ОписаниеЗадачи - ОписаниеЗадачи - <описание параметра>
//
//  Возвращаемое значение:
//   Структура - <описание возвращаемого значения>
//
Функция СформироватьДжоб(ОписаниеЗадачи)

	ТекущаяДжоба = Новый Соответствие();

	ТекущаяДжоба.Вставить("when", ОписаниеЗадачи.Когда);

	ТекущаяДжоба.Вставить("stage", ОписаниеЗадачи.Стадия);

	Если ОписаниеЗадачи.Переменные.Количество() > 0 Тогда
		ТекущаяДжоба.Вставить("variables", ОписаниеЗадачи.Переменные);
	КонецЕсли;

	Если НЕ ПустаяСтрока(ОписаниеЗадачи.Таймаут) Тогда
		ТекущаяДжоба.Вставить("timeout", ОписаниеЗадачи.Таймаут);
	КонецЕсли;

	ДобавитьОбраз(ТекущаяДжоба, ОписаниеЗадачи);

	ДобавитьСервисы(ТекущаяДжоба, ОписаниеЗадачи);

	ТекущаяДжоба.Вставить("tags", ОписаниеЗадачи.ТегиРаннера);

	Если ОписаниеЗадачи.СтартоватьСразу И ОписаниеЗадачи.Нуждается.Количество() > 0 Тогда
		ВызватьИсключение "СтартоватьСразу и Нуждается взаимоисключающие: "
			+ "нельзя стартовать немедленно и одновременно ждать другие джобы.";
	КонецЕсли;

	Если ОписаниеЗадачи.Нуждается.Количество() > 0 Тогда
		ТекущаяДжоба.Вставить("needs", ОписаниеЗадачи.Нуждается);
	ИначеЕсли ОписаниеЗадачи.СтартоватьСразу Тогда
		ТекущаяДжоба.Вставить("needs", Новый Массив());
	КонецЕсли;

	Если ОписаниеЗадачи.Зависимости.Количество() > 0 Тогда
		ТекущаяДжоба.Вставить("dependencies", ОписаниеЗадачи.Зависимости);
	КонецЕсли;

	ДобавитьПравила(ТекущаяДжоба, ОписаниеЗадачи);

	ДобавитьПараллельность(ТекущаяДжоба, ОписаниеЗадачи);

	ДобавитьГруппуРесурсов(ТекущаяДжоба, ОписаниеЗадачи);

	ДобавитьАртефакты(ТекущаяДжоба, ОписаниеЗадачи);

	ДобавитьПовтор(ТекущаяДжоба, ОписаниеЗадачи);

	ДобавитьОкружение(ТекущаяДжоба, ОписаниеЗадачи);

	Если ОписаниеЗадачи.ПередСкрипты.Количество() > 0 Тогда
		ТекущаяДжоба.Вставить("before_script", ОписаниеЗадачи.ПередСкрипты);
	КонецЕсли;

	ДобавитьКэш(ТекущаяДжоба, ОписаниеЗадачи);

	Если ОписаниеЗадачи.РазрешитьПадение Тогда
		ТекущаяДжоба.Вставить("allow_failure", Истина);
	КонецЕсли;

	Если ОписаниеЗадачи.Прерываемый Тогда
		ТекущаяДжоба.Вставить("interruptible", Истина);
	КонецЕсли;

	ТекущаяДжоба.Вставить("script", ОписаниеЗадачи.Скрипты);

	ДобавитьРелиз(ТекущаяДжоба, ОписаниеЗадачи);

	ДобавитьСтраницы(ТекущаяДжоба, ОписаниеЗадачи);

	Если ОписаниеЗадачи.ПослеСкрипты.Количество() > 0 Тогда
		ТекущаяДжоба.Вставить("after_script", ОписаниеЗадачи.ПослеСкрипты);
	КонецЕсли;

	Возврат ТекущаяДжоба;
КонецФункции

// <Описание процедуры>
//
// Параметры:
//   ОписаниеДжобы - Соответствие - <описание параметра>
//   ОписаниеЗадачи - ОписаниеЗадачи - <описание параметра>
//
Процедура ДобавитьОбраз(ОписаниеДжобы, ОписаниеЗадачи)
	
	Если ОписаниеЗадачи.Образ.Имя = "" Тогда
		Возврат;
	КонецЕсли;

	ОписаниеОбраза = Новый Структура("name", ОписаниеЗадачи.Образ.Имя);

	Команда = ОписаниеЗадачи.Образ.Энтрипоинт();
	Если Команда.Количество() > 0 Тогда
		ОписаниеОбраза.Вставить("entrypoint", Команда);
	КонецЕсли;

	Если НЕ ПустаяСтрока(ОписаниеЗадачи.Образ.ПолитикаОбраза) Тогда
		ОписаниеОбраза.Вставить("pull_policy", ОписаниеЗадачи.Образ.ПолитикаОбраза);
	КонецЕсли;

	ОписаниеДжобы.Вставить("image", ОписаниеОбраза);

КонецПроцедуры

// <Описание процедуры>
//
// Параметры:
//   ОписаниеДжобы - Соответствие - <описание параметра>
//   ОписаниеЗадачи - ОписаниеЗадачи - <описание параметра>
//
Процедура ДобавитьСервисы(ОписаниеДжобы, ОписаниеЗадачи)

	Если ОписаниеЗадачи.Сервисы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	СервисыПоКонтракту = Новый Массив();

	Для Каждого ОписаниеСервиса Из ОписаниеЗадачи.Сервисы Цикл

		СервисПоКонтракту = Новый Соответствие();
		СервисПоКонтракту.Вставить("name", ОписаниеСервиса.Имя);

		Если НЕ ПустаяСтрока(ОписаниеСервиса.Алиас) Тогда
			СервисПоКонтракту.Вставить("alias", ОписаниеСервиса.Алиас);
		КонецЕсли;

		Если ОписаниеСервиса.Энтрипоинт().Количество() > 0 Тогда
			СервисПоКонтракту.Вставить("entrypoint", ОписаниеСервиса.Энтрипоинт());
		КонецЕсли;

		Если ОписаниеСервиса.ПолучитьКоманду().Количество() > 0 Тогда
			СервисПоКонтракту.Вставить("command", ОписаниеСервиса.ПолучитьКоманду());
		КонецЕсли;

		Если ОписаниеСервиса.Переменные.Количество() > 0 Тогда
			СервисПоКонтракту.Вставить("variables", ОписаниеСервиса.Переменные);
		КонецЕсли;

		СервисыПоКонтракту.Добавить(СервисПоКонтракту);

	КонецЦикла;

	ОписаниеДжобы.Вставить("services", СервисыПоКонтракту);

КонецПроцедуры

// <Описание процедуры>
//
// Параметры:
//   ОписаниеДжобы - Соответствие - <описание параметра>
//   ОписаниеЗадачи - ОписаниеЗадачи - <описание параметра>
//
Процедура ДобавитьПравила(ОписаниеДжобы, ОписаниеЗадачи)
	Если ОписаниеЗадачи.Правила.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ПравилаПоКонтракту = Новый Массив();
	КодыВыходаДжобы = Новый Массив();

	Для Каждого Правило Из ОписаниеЗадачи.Правила Цикл

		ВалидироватьПравило(Правило);

		ПравилоПоКонтракту = Новый Соответствие();

		Если НЕ ПустаяСтрока(Правило.Условие) Тогда
			ПравилоПоКонтракту.Вставить("if", Правило.Условие);
		КонецЕсли;

		Если НЕ ПустаяСтрока(Правило.Когда) Тогда
			ПравилоПоКонтракту.Вставить("when", Правило.Когда);
		КонецЕсли;

		Если Правило.Изменения.Количество() > 0 Тогда
			Если НЕ ПустаяСтрока(Правило.СравнитьС) Тогда
				ИзмененияПоКонтракту = Новый Соответствие();
				ИзмененияПоКонтракту.Вставить("paths", Правило.Изменения);
				ИзмененияПоКонтракту.Вставить("compare_to", Правило.СравнитьС);
				ПравилоПоКонтракту.Вставить("changes", ИзмененияПоКонтракту);
			Иначе
				ПравилоПоКонтракту.Вставить("changes", Правило.Изменения);
			КонецЕсли;
		КонецЕсли;

		ДобавитьСуществуетВПравило(ПравилоПоКонтракту, Правило);

		Если Правило.Переменные.Количество() > 0 Тогда
			ПравилоПоКонтракту.Вставить("variables", Правило.Переменные);
		КонецЕсли;

		Если Правило.РазрешитьПадение = Истина И Правило.КодыВыходаПадения.Количество() = 0 Тогда
			ПравилоПоКонтракту.Вставить("allow_failure", Истина);
		ИначеЕсли Правило.РазрешитьПадение = Ложь Тогда
			ПравилоПоКонтракту.Вставить("allow_failure", Ложь);
		КонецЕсли;

		// exit_codes в rules:allow_failure не поддерживается GitLab — на уровень джобы
		Если Правило.КодыВыходаПадения.Количество() > 0 И КодыВыходаДжобы.Количество() = 0 Тогда
			Для Каждого Код Из Правило.КодыВыходаПадения Цикл
				КодыВыходаДжобы.Добавить(Код);
			КонецЦикла;
		КонецЕсли;

		ПравилаПоКонтракту.Добавить(ПравилоПоКонтракту);

	КонецЦикла;

	Если КодыВыходаДжобы.Количество() > 0 Тогда
		ПадениеДжобы = Новый Соответствие();
		ПадениеДжобы.Вставить("exit_codes", КодыВыходаДжобы);
		ОписаниеДжобы.Вставить("allow_failure", ПадениеДжобы);
	КонецЕсли;

	ОписаниеДжобы.Вставить("rules", ПравилаПоКонтракту);
КонецПроцедуры

// <Описание процедуры>
//
// Параметры:
//   ОписаниеДжобы - Соответствие - <описание параметра>
//   ОписаниеЗадачи - ОписаниеЗадачи - <описание параметра>
//

// Проверяет корректность правила перед выводом
//
// Параметры:
//   Правило - Структура - см. ОписаниеЗадачи.НовыйПравило()
//
Процедура ВалидироватьПравило(Правило)

	Если Правило.Существует.Количество() = 0
		И (НЕ ПустаяСтрока(Правило.СуществуетВПроекте)
			ИЛИ НЕ ПустаяСтрока(Правило.СуществуетПоРефу)) Тогда
		ВызватьИсключение "exists задан через project/ref без путей";
	КонецЕсли;

	Если Правило.КодыВыходаПадения.Количество() > 0
		И Правило.РазрешитьПадение <> Истина Тогда
		ВызватьИсключение "КодыВыходаПадения требуют РазрешитьПадение = Истина";
	КонецЕсли;

КонецПроцедуры

// Выводит exists правила: массив путей или соответствие paths/project/ref
//
// Параметры:
//   ПравилоПоКонтракту - Соответствие - правило YAML
//   Правило - Структура - см. ОписаниеЗадачи.НовыйПравило()
//
Процедура ДобавитьСуществуетВПравило(ПравилоПоКонтракту, Правило)

	ЕстьРасширенные = НЕ ПустаяСтрока(Правило.СуществуетВПроекте)
		ИЛИ НЕ ПустаяСтрока(Правило.СуществуетПоРефу);

	Если НЕ ЕстьРасширенные Тогда
		Если Правило.Существует.Количество() > 0 Тогда
			ПравилоПоКонтракту.Вставить("exists", Правило.Существует);
		КонецЕсли;
		Возврат;
	КонецЕсли;

	СуществуетПоКонтракту = Новый Соответствие();
	СуществуетПоКонтракту.Вставить("paths", Правило.Существует);

	Если НЕ ПустаяСтрока(Правило.СуществуетВПроекте) Тогда
		СуществуетПоКонтракту.Вставить("project", Правило.СуществуетВПроекте);
	КонецЕсли;

	Если НЕ ПустаяСтрока(Правило.СуществуетПоРефу) Тогда
		СуществуетПоКонтракту.Вставить("ref", Правило.СуществуетПоРефу);
	КонецЕсли;

	ПравилоПоКонтракту.Вставить("exists", СуществуетПоКонтракту);

КонецПроцедуры

Процедура ДобавитьПараллельность(ОписаниеДжобы, ОписаниеЗадачи)

	Параллельность = ОписаниеЗадачи.Параллельность;

	Если Параллельность.Количество > 0 И Параллельность.Матрица.Количество() > 0 Тогда
		ВызватьИсключение "parallel: число и matrix взаимоисключающие. Задайте либо Количество, либо Матрицу.";
	КонецЕсли;

	Если Параллельность.Количество > 0 Тогда
		ОписаниеДжобы.Вставить("parallel", Параллельность.Количество);
	ИначеЕсли Параллельность.Матрица.Количество() > 0 Тогда
		ОписаниеДжобы.Вставить("parallel", Новый Структура("matrix", Параллельность.Матрица));
	КонецЕсли;

КонецПроцедуры

// Сериализует доступ джобы к внешнему ресурсу через key resource_group,
// если для задачи задана группа ресурсов (иначе ключ не выводится).
//
// Параметры:
//   ОписаниеДжобы - Соответствие - формируемое описание джобы (ключи YAML)
//   ОписаниеЗадачи - ОписаниеЗадачи - задача, чья группа ресурсов выводится
//
Процедура ДобавитьГруппуРесурсов(ОписаниеДжобы, ОписаниеЗадачи)

	Если ПустаяСтрока(ОписаниеЗадачи.ГруппаРесурсов) Тогда
		Возврат;
	КонецЕсли;

	ОписаниеДжобы.Вставить("resource_group", ОписаниеЗадачи.ГруппаРесурсов);

КонецПроцедуры

// <Описание процедуры>
//
// Параметры:
//   ОписаниеДжобы - Соответствие - <описание параметра>
//   ОписаниеЗадачи - ОписаниеЗадачи - <описание параметра>
//
Процедура ДобавитьАртефакты(ОписаниеДжобы, ОписаниеЗадачи)

	Артефакты = ОписаниеЗадачи.Артефакты;

	Если Артефакты.Пути.Количество() = 0 И НЕ Артефакты.Неотслеживаемые Тогда
		Возврат;
	КонецЕсли;

	Артефакт = Новый Соответствие();

	Если НЕ ПустаяСтрока(Артефакты.Имя) Тогда
		Артефакт.Вставить("name", Артефакты.Имя);
	КонецЕсли;

	Артефакт.Вставить("when", Артефакты.Когда);

	Если Артефакты.Пути.Количество() > 0 Тогда
		Артефакт.Вставить("paths", Артефакты.Пути);
	КонецЕсли;

	Если Артефакты.Исключить.Количество() > 0 Тогда
		Артефакт.Вставить("exclude", Артефакты.Исключить);
	КонецЕсли;

	Если Артефакты.Неотслеживаемые Тогда
		Артефакт.Вставить("untracked", Истина);
	КонецЕсли;

	Если Артефакты.Публичный Тогда
		Артефакт.Вставить("public", Истина);
	КонецЕсли;

	Если НЕ ПустаяСтрока(Артефакты.ПоказыватьКак) Тогда
		Артефакт.Вставить("expose_as", Артефакты.ПоказыватьКак);
	КонецЕсли;

	Если НЕ ПустаяСтрока(Артефакты.ВремяХранения) Тогда
		Артефакт.Вставить("expire_in", Артефакты.ВремяХранения);
	КонецЕсли;

	Отчеты = Новый Соответствие();

	Для Каждого КлючЗначение Из Артефакты.Отчеты Цикл
		Отчеты.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
	КонецЦикла;

	Если Отчеты.Количество() > 0 Тогда
		Артефакт.Вставить("reports", Отчеты);
	КонецЕсли;

	ОписаниеДжобы.Вставить("artifacts", Артефакт);

КонецПроцедуры

Процедура ДобавитьПовтор(ОписаниеДжобы, ОписаниеЗадачи)

	Если ОписаниеЗадачи.Повтор.Повторы <= 0 Тогда
		Возврат;
	КонецЕсли;

	УникальныеПричины = СвернутьПричины(ОписаниеЗадачи.Повтор.ПовторыКогда);
	УникальныеКоды = СвернутьКоды(ОписаниеЗадачи.Повтор.КодыВыхода);

	Если УникальныеПричины.Количество() = 0 И УникальныеКоды.Количество() = 0 Тогда
		ОписаниеДжобы.Вставить("retry", ОписаниеЗадачи.Повтор.Повторы);
		Возврат;
	КонецЕсли;

	Повтор = Новый Соответствие();
	Повтор.Вставить("max", ОписаниеЗадачи.Повтор.Повторы);

	Если УникальныеПричины.Количество() = 1 Тогда
		Повтор.Вставить("when", УникальныеПричины[0]);
	ИначеЕсли УникальныеПричины.Количество() > 1 Тогда
		Повтор.Вставить("when", УникальныеПричины);
	КонецЕсли;

	Если УникальныеКоды.Количество() > 0 Тогда
		Повтор.Вставить("exit_codes", УникальныеКоды);
	КонецЕсли;

	ОписаниеДжобы.Вставить("retry", Повтор);

КонецПроцедуры

// Сворачивает массив причин повтора, устраняя дубли
//
// Параметры:
//   Причины - Массив из Строка -
//
//  Возвращаемое значение:
//   Массив из Строка -
//
Функция СвернутьПричины(Причины)

	Свернутые = Новый Массив();

	Для Каждого Причина Из Причины Цикл
		ДобавитьВМассивБезДублей(Свернутые, Причина);
	КонецЦикла;

	Возврат Свернутые;

КонецФункции

// Сворачивает массив кодов выхода, устраняя дубли
//
// Параметры:
//   Коды - Массив из Числа -
//
//  Возвращаемое значение:
//   Массив из Числа -
//
Функция СвернутьКоды(Коды)

	Свернутые = Новый Массив();

	Для Каждого Код Из Коды Цикл
		Если Свернутые.Найти(Код) = Неопределено Тогда
			Свернутые.Добавить(Код);
		КонецЕсли;
	КонецЦикла;

	Возврат Свернутые;

КонецФункции

// Собирает ключ release для джобы
//
// Параметры:
//   ОписаниеДжобы - Соответствие - собираемая джоба
//   ОписаниеЗадачи - ОписаниеЗадачи - модель джобы
//
Процедура ДобавитьРелиз(ОписаниеДжобы, ОписаниеЗадачи)

	РелизМодели = ОписаниеЗадачи.Релиз;

	Если РелизПустой(РелизМодели) Тогда
		Возврат;
	КонецЕсли;

	Если ПустаяСтрока(РелизМодели.Тег) Тогда
		ВызватьИсключение "Задача """ + ОписаниеЗадачи.Наименование
			+ """: не заполнен обязательный Релиз.Тег (release:tag_name)";
	КонецЕсли;

	Если ПустаяСтрока(РелизМодели.Описание) Тогда
		ВызватьИсключение "Задача """ + ОписаниеЗадачи.Наименование
			+ """: не заполнен обязательный Релиз.Описание (release:description)";
	КонецЕсли;

	БлокРелиза = Новый Соответствие();

	БлокРелиза.Вставить("tag_name", РелизМодели.Тег);

	Если НЕ ПустаяСтрока(РелизМодели.СообщениеТега) Тогда
		БлокРелиза.Вставить("tag_message", РелизМодели.СообщениеТега);
	КонецЕсли;

	Если НЕ ПустаяСтрока(РелизМодели.Имя) Тогда
		БлокРелиза.Вставить("name", РелизМодели.Имя);
	КонецЕсли;

	БлокРелиза.Вставить("description", РелизМодели.Описание);

	Если НЕ ПустаяСтрока(РелизМодели.Реф) Тогда
		БлокРелиза.Вставить("ref", РелизМодели.Реф);
	КонецЕсли;

	Если РелизМодели.Вехи.Количество() > 0 Тогда
		БлокРелиза.Вставить("milestones", РелизМодели.Вехи);
	КонецЕсли;

	Если НЕ ПустаяСтрока(РелизМодели.ДатаВыхода) Тогда
		БлокРелиза.Вставить("released_at", РелизМодели.ДатаВыхода);
	КонецЕсли;

	Если РелизМодели.Ссылки.Количество() > 0 Тогда

		СсылкиПоКонтракту = Новый Массив();

		Для Каждого Ссылка Из РелизМодели.Ссылки Цикл
			СсылкаПоКонтракту = Новый Соответствие();
			СсылкаПоКонтракту.Вставить("name", Ссылка.Имя);
			СсылкаПоКонтракту.Вставить("url", Ссылка.УРЛ);
			СсылкиПоКонтракту.Добавить(СсылкаПоКонтракту);
		КонецЦикла;

		БлокРелиза.Вставить("assets", Новый Структура("links", СсылкиПоКонтракту));

	КонецЕсли;

	ОписаниеДжобы.Вставить("release", БлокРелиза);

КонецПроцедуры

// Определяет, полностью ли пусто описание релиза (тогда ключ release не выводится)
//
// Параметры:
//   РелизМодели - ОписаниеРелиза -
//
//  Возвращаемое значение:
//   Булево - Истина, если не заполнено ни одно поле
//
Функция РелизПустой(РелизМодели)

	Возврат ПустаяСтрока(РелизМодели.Тег)
		И ПустаяСтрока(РелизМодели.Описание)
		И ПустаяСтрока(РелизМодели.Имя)
		И ПустаяСтрока(РелизМодели.Реф)
		И ПустаяСтрока(РелизМодели.СообщениеТега)
		И ПустаяСтрока(РелизМодели.ДатаВыхода)
		И РелизМодели.Вехи.Количество() = 0
		И РелизМодели.Ссылки.Количество() = 0;

КонецФункции

// Выводит блок environment джобы (деплой-окружение)
//
// Параметры:
//   ОписаниеДжобы - Соответствие - формируемая джоба
//   ОписаниеЗадачи - ОписаниеЗадачи - модель джобы
//
Процедура ДобавитьОкружение(ОписаниеДжобы, ОписаниеЗадачи)

	Окружение = ОписаниеЗадачи.Окружение;

	Если ПустаяСтрока(Окружение.Имя) Тогда
		Возврат;
	КонецЕсли;

	ОписаниеОкружения = Новый Соответствие();
	ОписаниеОкружения.Вставить("name", Окружение.Имя);

	Если НЕ ПустаяСтрока(Окружение.УРЛ) Тогда
		ОписаниеОкружения.Вставить("url", Окружение.УРЛ);
	КонецЕсли;

	Если НЕ ПустаяСтрока(Окружение.ПриОстановке) Тогда
		ОписаниеОкружения.Вставить("on_stop", Окружение.ПриОстановке);
	КонецЕсли;

	Если НЕ ПустаяСтрока(Окружение.Действие) Тогда
		ОписаниеОкружения.Вставить("action", Окружение.Действие);
	КонецЕсли;

	Если НЕ ПустаяСтрока(Окружение.АвтоОстановка) Тогда
		ОписаниеОкружения.Вставить("auto_stop_in", Окружение.АвтоОстановка);
	КонецЕсли;

	ОписаниеДжобы.Вставить("environment", ОписаниеОкружения);

КонецПроцедуры

// Выводит блок pages джобы (GitLab Pages, pages:publish, GitLab 17.10+)
// и добавляет путь публикации в artifacts.paths
//
// Параметры:
//   ОписаниеДжобы - Соответствие - формируемая джоба
//   ОписаниеЗадачи - ОписаниеЗадачи - модель джобы
//
Процедура ДобавитьСтраницы(ОписаниеДжобы, ОписаниеЗадачи)

	ЭтоПейджес = ОписаниеЗадачи.Наименование = Гитлаб.ИмяЗадачиСтраниц();
	ПутьЭкспорта = ОписаниеЗадачи.Страницы.ПутьЭкспорта;

	Если НЕ ЭтоПейджес И ПустаяСтрока(ПутьЭкспорта) Тогда
		Возврат;
	КонецЕсли;

	АртефактыПусты = ОписаниеЗадачи.Артефакты.Пути.Количество() = 0;

	Если ЭтоПейджес И ПустаяСтрока(ПутьЭкспорта) И АртефактыПусты Тогда
		ВызватьИсключение "Джоба pages не публикует артефакты: задайте Страницы.Публиковать(путь) или добавьте artifacts:paths";
	КонецЕсли;

	Если ЭтоПейджес И ОписаниеЗадачи.Стадия <> "deploy" Тогда
		ВызватьИсключение "Джоба pages должна быть в стадии deploy (текущая: " + ОписаниеЗадачи.Стадия + ")";
	КонецЕсли;

	Если НЕ ПустаяСтрока(ПутьЭкспорта) Тогда
		ОписаниеДжобы.Вставить("pages", Новый Структура("publish", ПутьЭкспорта));

		// pages:publish добавляет путь в artifacts.paths (GitLab 17.10+)
		Если ОписаниеДжобы["artifacts"] = Неопределено Тогда
			БлокАртефактов = Новый Соответствие();
			Пути = Новый Массив();
			Пути.Добавить(ПутьЭкспорта);
			БлокАртефактов.Вставить("paths", Пути);
			ОписаниеДжобы.Вставить("artifacts", БлокАртефактов);
		Иначе
			Пути = ОписаниеДжобы["artifacts"]["paths"];
			Если Пути.Найти(ПутьЭкспорта) = Неопределено Тогда
				Пути.Добавить(ПутьЭкспорта);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьКэш(ОписаниеДжобы, ОписаниеЗадачи)

	Если ОписаниеЗадачи.Кэш.Пути.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Кэш = Новый Соответствие();
	Кэш.Вставить("paths", ОписаниеЗадачи.Кэш.Пути);

	Если ОписаниеЗадачи.Кэш.КлючПоФайлам.Количество() > 0 Тогда
		ОбъектКлюча = Новый Соответствие();
		ОбъектКлюча.Вставить("files", ОписаниеЗадачи.Кэш.КлючПоФайлам);
		Если НЕ ПустаяСтрока(ОписаниеЗадачи.Кэш.ПрефиксКлюча) Тогда
			ОбъектКлюча.Вставить("prefix", ОписаниеЗадачи.Кэш.ПрефиксКлюча);
		КонецЕсли;
		Кэш.Вставить("key", ОбъектКлюча);
	ИначеЕсли ОписаниеЗадачи.Кэш.КлючПоКоммитам.Количество() > 0 Тогда
		ОбъектКлюча = Новый Соответствие();
		ОбъектКлюча.Вставить("files_commits", ОписаниеЗадачи.Кэш.КлючПоКоммитам);
		Если НЕ ПустаяСтрока(ОписаниеЗадачи.Кэш.ПрефиксКлюча) Тогда
			ОбъектКлюча.Вставить("prefix", ОписаниеЗадачи.Кэш.ПрефиксКлюча);
		КонецЕсли;
		Кэш.Вставить("key", ОбъектКлюча);
	ИначеЕсли НЕ ПустаяСтрока(ОписаниеЗадачи.Кэш.Ключ) Тогда
		Кэш.Вставить("key", ОписаниеЗадачи.Кэш.Ключ);
	КонецЕсли;

	Кэш.Вставить("when", ОписаниеЗадачи.Кэш.Когда);
	Кэш.Вставить("policy", ОписаниеЗадачи.Кэш.Политика);

	Если ОписаниеЗадачи.Кэш.Неотслеживаемые Тогда
		Кэш.Вставить("untracked", Истина);
	КонецЕсли;

	Если ОписаниеЗадачи.Кэш.БезЗащиты Тогда
		Кэш.Вставить("unprotect", Истина);
	КонецЕсли;

	Если ОписаниеЗадачи.Кэш.РезервныеКлючи.Количество() > 0 Тогда
		Кэш.Вставить("fallback_keys", ОписаниеЗадачи.Кэш.РезервныеКлючи);
	КонецЕсли;

	ОписаниеДжобы.Вставить("cache", Кэш);
КонецПроцедуры

// <Описание процедуры>
//
// Параметры:
//   Массив - Массив - <описание параметра>
//   Значение - Произвольный - <описание параметра>
//
Процедура ДобавитьВМассивБезДублей(Массив, Значение)
	Если Массив.Найти(Значение) = Неопределено Тогда
		Массив.Добавить(Значение);
	КонецЕсли;
КонецПроцедуры

// <Описание процедуры>
//
// Параметры:
//   ПутьКФайлу - Строка - <описание параметра>
//   Текст - Строка - <описание параметра>
//
Процедура ЗаписатьТекстВФайл(ПутьКФайлу, Текст)
	ЗаписьТекста = Новый ЗаписьТекста(ПутьКФайлу, КодировкаТекста.UTF8NoBOM);
	ЗаписьТекста.Записать(Текст);
	ЗаписьТекста.Закрыть();
КонецПроцедуры
