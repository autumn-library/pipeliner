// BSLLS:ExportVariables-off

Перем Имя Экспорт; // Строка
Перем Энтрипоинт; // Массив из Строка
Перем ПолитикаОбраза Экспорт; // Строка - политика скачивания образа (image:pull_policy)

&Желудь
&Характер("Компанейский")
Процедура ПриСозданииОбъекта()

	Имя = "";
	Энтрипоинт = Новый Массив();
	ПолитикаОбраза = "";

КонецПроцедуры

// <Описание процедуры>
//
// Параметры:
//   Команда - Строка - 
//
Процедура ДобавитьКомандуЭнтрипоинт(Команда) Экспорт
	Энтрипоинт.Добавить(Команда);
КонецПроцедуры

// <Описание функции>
//
//  Возвращаемое значение:
//   Массив из Строка -
//
Функция Энтрипоинт() Экспорт
	Возврат Энтрипоинт;
КонецФункции

// Все допустимые политики скачивания образа (image:pull_policy)
//
//  Возвращаемое значение:
//   Массив из Строка -
//
Функция ДопустимыеПолитики() Экспорт

	Допустимые = Новый Массив();
	Допустимые.Добавить("always");
	Допустимые.Добавить("never");
	Допустимые.Добавить("if-not-present");
	// "pull" распознаётся свежими версиями GitLab и раннера (>= 15.1)
	Допустимые.Добавить("pull");

	Возврат Допустимые;

КонецФункции

// Задаёт политику скачивания образа с валидацией (см. ДопустимыеПолитики)
//
// Параметры:
//   Политика - Строка - например "always" или "if-not-present"
//
Процедура УказатьПолитику(Политика) Экспорт

	Если ДопустимыеПолитики().Найти(Политика) = Неопределено Тогда
		ВызватьИсключение "Недопустимая политика скачивания образа: " + Политика
			+ ". Допустимые значения: " + СтрСоединить(ДопустимыеПолитики(), ", ");
	КонецЕсли;

	ПолитикаОбраза = Политика;

КонецПроцедуры