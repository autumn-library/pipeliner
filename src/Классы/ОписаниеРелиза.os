// BSLLS:ExportVariables-off

Перем Тег Экспорт; // Строка - тег релиза (release:tag_name), например v1.0.0 или $CI_COMMIT_TAG
Перем СообщениеТега Экспорт; // Строка - сообщение аннотированного тега (release:tag_message)
Перем Имя Экспорт; // Строка - название релиза (release:name), если пусто GitLab возьмет tag_name
Перем Описание Экспорт; // Строка - длинное описание релиза (release:description), текст или путь к файлу
Перем Реф Экспорт; // Строка - ref для создаваемого тега (release:ref): SHA, имя тега или ветки
Перем Вехи Экспорт; // Массив из Строка - заголовки вех (release:milestones)
Перем ДатаВыхода Экспорт; // Строка - дата и время готовности релиза (release:released_at), ISO 8601
Перем Ссылки Экспорт; // Массив из Структура{Имя, УРЛ} - ссылки на ассеты релиза (release:assets:links)

&Желудь
&Характер("Компанейский")
Процедура ПриСозданииОбъекта()

	Тег = "";
	СообщениеТега = "";
	Имя = "";
	Описание = "";
	Реф = "";
	Вехи = Новый Массив();
	ДатаВыхода = "";
	Ссылки = Новый Массив();

КонецПроцедуры

// Добавляет веху, с которой связывается релиз
//
// Параметры:
//   Веха - Строка - заголовок вехи, например 1.0
//
Процедура ДобавитьВеху(Веха) Экспорт

	Вехи.Добавить(Веха);

КонецПроцедуры

// Добавляет ссылку на ассет релиза
//
// Параметры:
//   Имя - Строка - отображаемое имя ссылки
//   УРЛ - Строка - адрес ссылки
//
Процедура ДобавитьСсылку(Имя, УРЛ) Экспорт

	Ссылка = Новый Структура("Имя, УРЛ", Имя, УРЛ);
	Ссылки.Добавить(Ссылка);

КонецПроцедуры
