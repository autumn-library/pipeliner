// BSLLS:ExportVariables-off

Перем Количество Экспорт; // Число
Перем Матрица Экспорт; // Массив из Соответствие

&Желудь
&Характер("Компанейский")
Процедура ПриСозданииОбъекта()

	Количество = 0;
	Матрица = Новый Массив();

КонецПроцедуры

// Добавляет ряд матрицы параметров (parallel: matrix)
//
// Параметры:
//   ИмяПеременной - Строка - имя переменной ряда, например OS
//   Значения - Массив из Строка - значения ряда, например ["ubuntu", "windows"]
//
Процедура ДобавитьРядМатрицы(ИмяПеременной, Значения) Экспорт

	Ряд = Новый Соответствие();
	Ряд.Вставить(ИмяПеременной, Значения);
	Матрица.Добавить(Ряд);

КонецПроцедуры

// Добавляет ряд матрицы из соответствия (декартово произведение нескольких переменных)
//
// Параметры:
//   Ряд - Соответствие - ряд вида {OS: [ubuntu, windows], VERSION: [17, 19]}
//                        - комбинации всех переменных ряда перемножаются
//
Процедура ДобавитьРяд(Ряд) Экспорт
	Матрица.Добавить(Ряд);
КонецПроцедуры
