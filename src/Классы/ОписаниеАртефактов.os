// BSLLS:ExportVariables-off

Перем Имя Экспорт; // Строка
Перем ВремяХранения Экспорт; // Строка
Перем Когда Экспорт; // Строка
Перем Пути Экспорт; // Массив из Строка
Перем Исключить Экспорт; // Массив из Строка
Перем Неотслеживаемые Экспорт; // Булево
Перем Публичный Экспорт; // Булево
Перем ПоказыватьКак Экспорт; // Строка
Перем ОтчетыJUnit Экспорт; // Массив из Строка
Перем Отчеты Экспорт; // Соответствие - ключ: тип отчета, значение: массив путей или структура

&Желудь
&Характер("Компанейский")
Процедура ПриСозданииОбъекта()

	ПриУспехе();

	Имя = "";
	ВремяХранения = "";
	Пути = Новый Массив();
	Исключить = Новый Массив();
	Неотслеживаемые = Ложь;
	Публичный = Ложь;
	ПоказыватьКак = "";
	ОтчетыJUnit = Новый Массив();
	Отчеты = Новый Соответствие();

КонецПроцедуры

Процедура Всегда() Экспорт

	Когда = СобытияПайплайна.Всегда();
	
КонецПроцедуры

Процедура ПриУспехе() Экспорт

	Когда = СобытияПайплайна.ПриУспехе();
	
КонецПроцедуры

Процедура ПриНеудаче() Экспорт

	Когда = СобытияПайплайна.ПриНеудаче();
	
КонецПроцедуры

// Добавляет путь в список путей артефакта
//
// Параметры:
//   Путь - Строка -
//
Процедура ДобавитьПуть(Путь) Экспорт
	Пути.Добавить(Путь);
КонецПроцедуры

// Добавляет путь в список исключений
//
// Параметры:
//   Путь - Строка -
//
Процедура ДобавитьИсключение(Путь) Экспорт
	Исключить.Добавить(Путь);
КонецПроцедуры

// Добавляет файл в JUnit-отчет
//
// Параметры:
//   Путь - Строка -
//
Процедура ДобавитьОтчетJUnit(Путь) Экспорт
	ОтчетыJUnit.Добавить(Путь);
КонецПроцедуры

// Добавляет отчет по типу. Для coverage_report используйте ДобавитьОтчетПокрытия
//
// Параметры:
//   Тип - Строка - тип отчета: junit, dotenv, sast, dependency_scanning и т.п.
//   Путь - Строка - путь к файлу отчета
//
Процедура ДобавитьОтчет(Тип, Путь) Экспорт

	Если НеДопустимыйВидОтчета(Тип) Тогда
		ВызватьИсключение "Недопустимый вид отчета: " + Тип
			+ ". Допустимые значения: " + СтрСоединить(ВидыОтчетов.Допустимые(), ", ");
	КонецЕсли;

	Если Отчеты[Тип] = Неопределено Тогда
		Отчеты.Вставить(Тип, Новый Массив());
	КонецЕсли;

	Отчеты[Тип].Добавить(Путь);

КонецПроцедуры

// Добавляет отчет о покрытии (coverage_report)
//
// Параметры:
//   Формат - Строка - cobertura, jacoco, lcov, simplecov
//   Путь - Строка - путь к файлу отчета
//
Процедура ДобавитьОтчетПокрытия(Формат, Путь) Экспорт

	Если НеДопустимыйФорматПокрытия(Формат) Тогда
		ВызватьИсключение "Недопустимый формат покрытия: " + Формат
			+ ". Допустимые значения: " + СтрСоединить(ВидыОтчетов.ФорматыПокрытия(), ", ");
	КонецЕсли;

	Отчеты.Вставить("coverage_report", Новый Структура("coverage_format, path", Формат, Путь));

КонецПроцедуры

Функция НеДопустимыйВидОтчета(Тип)

	Для Каждого Допустимый Из ВидыОтчетов.Допустимые() Цикл
		Если Допустимый = Тип Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

Функция НеДопустимыйФорматПокрытия(Формат)

	Для Каждого Допустимый Из ВидыОтчетов.ФорматыПокрытия() Цикл
		Если Допустимый = Формат Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции
