// BSLLS:ExportVariables-off

Перем Повторы Экспорт; // Число
Перем ПовторыКогда Экспорт; // Массив из Строка
Перем КодыВыхода Экспорт; // Массив из Числа

&Желудь
&Характер("Компанейский")
Процедура ПриСозданииОбъекта()

	Повторы = 0;
	ПовторыКогда = Новый Массив();
	КодыВыхода = Новый Массив();

КонецПроцедуры

// Добавляет условие повтора (см. УсловияПовтора)
//
// Параметры:
//   Условие - Строка - причина повтора, например script_failure
//
Процедура ДобавитьУсловие(Условие) Экспорт

	Если НеДопустимоеУсловие(Условие) Тогда
		ВызватьИсключение "Недопустимое условие повтора: " + Условие
			+ ". Допустимые значения: " + СтрСоединить(УсловияПовтора.Допустимые(), ", ");
	КонецЕсли;

	ПовторыКогда.Добавить(Условие);

КонецПроцедуры

// Добавляет код выхода, при котором нужно повторить джобу
//
// Параметры:
//   Код - Число - код выхода скрипта
//
Процедура ДобавитьКодВыхода(Код) Экспорт
	КодыВыхода.Добавить(Код);
КонецПроцедуры

Функция НеДопустимоеУсловие(Условие)

	Для Каждого Допустимое Из УсловияПовтора.Допустимые() Цикл
		Если Допустимое = Условие Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции
