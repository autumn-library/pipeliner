// BSLLS:ExportVariables-off

Перем Повторы Экспорт; // Число
Перем ПовторыКогда Экспорт; // Массив из Строка

&Желудь
&Характер("Компанейский")
Процедура ПриСозданииОбъекта()

	Повторы = 0;
	ПовторыКогда = Новый Массив();

КонецПроцедуры

// Добавляет условие повтора (script_failure, runner_system_failure и т.д.)
//
// Параметры:
//   Условие - Строка -
//
Процедура ДобавитьУсловие(Условие) Экспорт
	ПовторыКогда.Добавить(Условие);
КонецПроцедуры
