// BSLLS:ExportVariables-off

Перем ПутьЭкспорта Экспорт; // Строка - путь публикации (pages:publish)

&Желудь
&Характер("Компанейский")
Процедура ПриСозданииОбъекта()

	ПутьЭкспорта = "";

КонецПроцедуры

// Задаёт путь публикации GitLab Pages (pages:publish, GitLab 17.10+)
//
// Параметры:
//   Путь - Строка - каталог публикации, например dist
//
Процедура Публиковать(Путь) Экспорт

	ПутьЭкспорта = Путь;

КонецПроцедуры

// Возвращает путь публикации
//
//  Возвращаемое значение:
//   Строка -
//
Функция ПутьПубликации() Экспорт

	Возврат ПутьЭкспорта;

КонецФункции
