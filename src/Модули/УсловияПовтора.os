// Причины повтора для retry.when
//
// Возвращаемое значение:
//   Строка - причина повтора

// Все допустимые причины повтора
//
//  Возвращаемое значение:
//   Массив из Строка -
//
Функция Допустимые() Экспорт

	Допустимые = Новый Массив();
	Допустимые.Добавить("always");
	Допустимые.Добавить("unknown_failure");
	Допустимые.Добавить("script_failure");
	Допустимые.Добавить("api_failure");
	Допустимые.Добавить("stuck_or_timeout_failure");
	Допустимые.Добавить("stuck_pending_with_matching_runners");
	Допустимые.Добавить("stuck_pending_no_matching_runners");
	Допустимые.Добавить("no_updates_running");
	Допустимые.Добавить("no_updates_canceling");
	Допустимые.Добавить("runner_system_failure");
	Допустимые.Добавить("runner_configuration_error");
	Допустимые.Добавить("runner_external_dependency_failure");
	Допустимые.Добавить("runner_interrupted");
	Допустимые.Добавить("runner_unsupported");
	Допустимые.Добавить("stale_schedule");
	Допустимые.Добавить("job_execution_timeout");
	Допустимые.Добавить("server_timeout_running");
	Допустимые.Добавить("server_timeout_canceling");
	Допустимые.Добавить("archived_failure");
	Допустимые.Добавить("unmet_prerequisites");
	Допустимые.Добавить("scheduler_failure");
	Допустимые.Добавить("data_integrity_failure");

	Возврат Допустимые;

КонецФункции

// Повтор при любой ошибке (по умолчанию)
Функция Всегда() Экспорт
	Возврат "always";
КонецФункции

// Повтор при неизвестной причине сбоя
Функция НеизвестныйСбой() Экспорт
	Возврат "unknown_failure";
КонецФункции

// Повтор при падении скрипта или ошибке пулла образа
Функция СбойСкрипта() Экспорт
	Возврат "script_failure";
КонецФункции

// Повтор при ошибке API
Функция СбойАПИ() Экспорт
	Возврат "api_failure";
КонецФункции

// Повтор при зависании или таймауте джобы (устарело, используйте конкретные причины)
Функция ЗависаниеИлиТаймаут() Экспорт
	Возврат "stuck_or_timeout_failure";
КонецФункции

// Повтор при ожидании раннеров
Функция ОжиданиеРаннеров() Экспорт
	Возврат "stuck_pending_with_matching_runners";
КонецФункции

// Повтор при отсутствии подходящих раннеров
Функция НетПодходящихРаннеров() Экспорт
	Возврат "stuck_pending_no_matching_runners";
КонецФункции

// Повтор при отсутствии обновлений во время запуска
Функция НетОбновленийПриЗапуске() Экспорт
	Возврат "no_updates_running";
КонецФункции

// Повтор при отсутствии обновлений во время отмены
Функция НетОбновленийПриОтмене() Экспорт
	Возврат "no_updates_canceling";
КонецФункции

// Повтор при системном сбое раннера
Функция СбойРаннера() Экспорт
	Возврат "runner_system_failure";
КонецФункции

// Повтор при ошибке конфигурации CI/CD или раннера
Функция ОшибкаКонфигурацииРаннера() Экспорт
	Возврат "runner_configuration_error";
КонецФункции

// Повтор при недоступности внешней зависимости (реестр образов и т.п.)
Функция СбойВнешнейЗависимостиРаннера() Экспорт
	Возврат "runner_external_dependency_failure";
КонецФункции

// Повтор при прерывании раннера (перезапуск, выключение)
Функция РаннерПрерван() Экспорт
	Возврат "runner_interrupted";
КонецФункции

// Повтор при неподдерживаемом раннере
Функция РаннерНеПоддерживается() Экспорт
	Возврат "runner_unsupported";
КонецФункции

// Повтор при невозможности выполнить отложенную джобу
Функция ПросроченнаяЗадача() Экспорт
	Возврат "stale_schedule";
КонецФункции

// Повтор при превышении максимального времени выполнения (устарело)
Функция ПревышеноВремяВыполнения() Экспорт
	Возврат "job_execution_timeout";
КонецФункции

// Повтор при таймауте сервера во время выполнения
Функция ТаймаутСервераПриЗапуске() Экспорт
	Возврат "server_timeout_running";
КонецФункции

// Повтор при таймауте сервера во время отмены
Функция ТаймаутСервераПриОтмене() Экспорт
	Возврат "server_timeout_canceling";
КонецФункции

// Повтор при попытке запуска архивированной джобы
Функция ЗадачаВАрхиве() Экспорт
	Возврат "archived_failure";
КонецФункции

// Повтор при невыполнении предпосылок джобы
Функция НеВыполненыПредпосылки() Экспорт
	Возврат "unmet_prerequisites";
КонецФункции

// Повтор при сбое планировщика
Функция СбойПланировщика() Экспорт
	Возврат "scheduler_failure";
КонецФункции

// Повтор при нарушении целостности данных
Функция НарушениеЦелостностиДанных() Экспорт
	Возврат "data_integrity_failure";
КонецФункции
