// Виды отчетов для artifacts.reports
//
// Возвращаемое значение:
//   Строка - вид отчета

// Все допустимые виды отчетов (кроме coverage_report, у него отдельный формат)
//
//  Возвращаемое значение:
//   Массив из Строка -
//
Функция Допустимые() Экспорт

	Допустимые = Новый Массив();
	Допустимые.Добавить("accessibility");
	Допустимые.Добавить("annotations");
	Допустимые.Добавить("api_fuzzing");
	Допустимые.Добавить("browser_performance");
	Допустимые.Добавить("codequality");
	Допустимые.Добавить("container_scanning");
	Допустимые.Добавить("coverage_fuzzing");
	Допустимые.Добавить("cyclonedx");
	Допустимые.Добавить("dast");
	Допустимые.Добавить("dependency_scanning");
	Допустимые.Добавить("dotenv");
	Допустимые.Добавить("junit");
	Допустимые.Добавить("load_performance");
	Допустимые.Добавить("metrics");
	Допустимые.Добавить("requirements");
	Допустимые.Добавить("sarif");
	Допустимые.Добавить("sast");
	Допустимые.Добавить("secret_detection");
	Допустимые.Добавить("terraform");

	Возврат Допустимые;

КонецФункции

// Допустимые форматы отчета о покрытии (coverage_report)
//
//  Возвращаемое значение:
//   Массив из Строка -
//
Функция ФорматыПокрытия() Экспорт

	Форматы = Новый Массив();
	Форматы.Добавить("cobertura");
	Форматы.Добавить("jacoco");
	Форматы.Добавить("lcov");
	Форматы.Добавить("simplecov");

	Возврат Форматы;

КонецФункции

// Формат покрытия Cobertura
Функция Кобертура() Экспорт
	Возврат "cobertura";
КонецФункции

// Формат покрытия JaCoCo
Функция Джакоко() Экспорт
	Возврат "jacoco";
КонецФункции

// Формат покрытия LCOV
Функция ЛКов() Экспорт
	Возврат "lcov";
КонецФункции

// Формат покрытия SimpleCov
Функция СимплКов() Экспорт
	Возврат "simplecov";
КонецФункции

