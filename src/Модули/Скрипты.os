// vrunner infobase extensions set-options --ibconnection <СтрокаПодключения>
//		[--safe-mode <БезопасныйРежим>] [--unsafe-action-protection <ЗащитаОтОпасныхДействий>]
//		[--active <Активно>] <ИмяРасширения>
//
// Параметры:
//   СтрокаПодключения - Строка - Например: /Fbuild/ib
//   ИмяРасширения - Строка - Например: YAXUNIT
//   БезопасныйРежим - Булево - значение --safe-mode (true/false)
//   ЗащитаОтОпасныхДействий - Булево - значение --unsafe-action-protection (true/false)
//   Активно - Булево - значение --active (true/false)
//
//  Возвращаемое значение:
//   Строка - 
//
Функция НастройкаФлаговРасширения(СтрокаПодключения,
		ИмяРасширения,
		БезопасныйРежим = Неопределено,
		ЗащитаОтОпасныхДействий = Неопределено,
		Активно = Неопределено) Экспорт
	
	Шаблон = "vrunner infobase extensions set-options --ibconnection %1%2%3%4 %5";

	Возврат СтрШаблон(Шаблон,
		СтрокаПодключения,
		ОпцияБулево("--safe-mode", БезопасныйРежим),
		ОпцияБулево("--unsafe-action-protection", ЗащитаОтОпасныхДействий),
		ОпцияБулево("--active", Активно),
		ИмяРасширения);

КонецФункции

// vrunner run designer --ibconnection <СтрокаПодключения> [--additional <ДополнительныеПараметры>] [--no-wait]
//
// Параметры:
//   СтрокаПодключения - Строка - Например: /Fbuild/ib
//   ДополнительныеПараметры - Строка - дополнительные параметры запуска Конфигуратора
//   НеЖдатьЗавершения - Булево - Флаг --no-wait
//
//  Возвращаемое значение:
//   Строка - 
//
Функция ЗапуститьКонфигуратор(СтрокаПодключения,
		ДополнительныеПараметры = Неопределено,
		НеЖдатьЗавершения = Ложь) Экспорт
	
	Шаблон = "vrunner run designer --ibconnection %1%2%3";

	Возврат СтрШаблон(Шаблон,
		СтрокаПодключения,
		Опция("--additional", ДополнительныеПараметры),
		ФлагОпции("--no-wait", НеЖдатьЗавершения));

КонецФункции

// vrunner run enterprise [--ibsrv] --ibconnection <СтрокаПодключения>
//		--command "ЗапуститьОбновлениеИнформационнойБазы;ЗавершитьРаботуСистемы;"
//		--execute "<ПутьДоОбработки>"
//
// Параметры:
//   СтрокаПодключения - Строка - Например: /Fbuild/ib
//   ПутьДоОбработки - Строка - Например: $runnerRoot/epf/ЗакрытьПредприятие.epf
//   ИспользоватьАвтономныйСервер - Булево - Флаг --ibsrv
//
//  Возвращаемое значение:
//   Строка - 
//
Функция ОбновитьБазуВРежимеПредприятия(СтрокаПодключения,
		ПутьДоОбработки,
		ИспользоватьАвтономныйСервер = Истина) Экспорт
	
	Шаблон = "vrunner run enterprise%1 --ibconnection %2 "
		+ "--command ""ЗапуститьОбновлениеИнформационнойБазы;ЗавершитьРаботуСистемы;"" "
		+ "--execute ""%3""";

	Возврат СтрШаблон(Шаблон,
		ФлагОпции("--ibsrv", ИспользоватьАвтономныйСервер),
		СтрокаПодключения,
		ПутьДоОбработки);

КонецФункции

// vrunner test xunit --ibconnection <СтрокаПодключения>
//		[--report-format junit --report-path <ПутьОтчета>] [--xddExitCodePath <ФайлКодаВозврата>] <КаталогТестов>
//
// Параметры:
//   СтрокаПодключения - Строка - Например: /Fbuild/ib
//   КаталогТестов - Строка - каталог или файл с тестами
//   ПутьОтчета - Строка - путь к JUnit-отчёту
//   ФайлКодаВозврата - Строка - файл статуса тестирования (--xddExitCodePath)
//
//  Возвращаемое значение:
//   Строка - 
//
Функция ЗапускТестовИксЮнит(СтрокаПодключения,
		КаталогТестов,
		ПутьОтчета = Неопределено,
		ФайлКодаВозврата = Неопределено) Экспорт
	
	Шаблон = "vrunner test xunit --ibconnection %1%2%3 %4";

	Возврат СтрШаблон(Шаблон,
		СтрокаПодключения,
		?(ПутьОтчета = Неопределено, "", " --report-format junit --report-path " + ПутьОтчета),
		Опция("--xddExitCodePath", ФайлКодаВозврата),
		КаталогТестов);

КонецФункции

// vrunner test yaxunit [--ibsrv] --ibconnection <СтрокаПодключения>
//		[--yaxunit-config <ФайлНастроекЯксЮнит>] [--report-format junit --report-path <ПутьОтчета>]
//
// Параметры:
//   СтрокаПодключения - Строка - Например: /Fbuild/ib
//   ФайлНастроекЯксЮнит - Строка - готовый yaxunit.json (--yaxunit-config)
//   ПутьОтчета - Строка - путь к JUnit-отчёту
//   ИспользоватьАвтономныйСервер - Булево - Флаг --ibsrv
//
//  Возвращаемое значение:
//   Строка - 
//
Функция ЗапускТестовЯксЮнит(СтрокаПодключения,
		ФайлНастроекЯксЮнит = Неопределено,
		ПутьОтчета = Неопределено,
		ИспользоватьАвтономныйСервер = Истина) Экспорт
	
	Шаблон = "vrunner test yaxunit%1 --ibconnection %2%3%4";

	Возврат СтрШаблон(Шаблон,
		ФлагОпции("--ibsrv", ИспользоватьАвтономныйСервер),
		СтрокаПодключения,
		Опция("--yaxunit-config", ФайлНастроекЯксЮнит),
		?(ПутьОтчета = Неопределено, "", " --report-format junit --report-path " + ПутьОтчета));

КонецФункции

// vrunner test vanessa [--ibsrv] --ibconnection <СтрокаПодключения>
//		--vanessasettings <ФайлПараметровВА> --bddrunner-path <ПутьОбработкиВА>
//		--workspace <КореньПроекта>
//
// Параметры:
//   СтрокаПодключения - Строка - Например: /Fbuild/ib
//   ФайлПараметровВА - Строка - файл настроек Vanessa-ADD (--vanessasettings)
//   ПутьОбработкиВА - Строка - путь к bddRunner.epf (--bddrunner-path)
//   КореньПроекта - Строка - каталог проекта (--workspace)
//   ИспользоватьАвтономныйСервер - Булево - Флаг --ibsrv
//
//  Возвращаемое значение:
//   Строка - 
//
Функция ЗапускТестовВА(СтрокаПодключения,
		ФайлПараметровВА,
		ПутьОбработкиВА,
		КореньПроекта,
		ИспользоватьАвтономныйСервер = Истина) Экспорт
	
	Шаблон = "vrunner test vanessa%1 --ibconnection %2 "
		+ "--vanessasettings %3 --bddrunner-path %4 --workspace %5";

	Возврат СтрШаблон(Шаблон,
		ФлагОпции("--ibsrv", ИспользоватьАвтономныйСервер),
		СтрокаПодключения,
		ФайлПараметровВА,
		ПутьОбработкиВА,
		КореньПроекта);

КонецФункции

// vrunner validate syntax-check [--ibconnection <СтрокаПодключения>]
//		[--mode <Режим> ...] [--target <Цель> ...]
//		[--report-format junit --report-path <ПутьОтчета>]
//		[--exception-file <ФайлИсключений>] [--groupbymetadata]
//
// Параметры:
//   СтрокаПодключения - Строка - Например: /Fbuild/ib
//   Режимы - Массив из Строка - режимы проверки (повторяемая опция --mode)
//   Цели - Массив из Строка - цели проверки (повторяемая опция --target)
//   ПутьОтчета - Строка - путь к JUnit-отчёту
//   ФайлИсключений - Строка - файл исключений замечаний
//   ГруппироватьПоМетаданным - Булево - Флаг --groupbymetadata
//
//  Возвращаемое значение:
//   Строка - 
//
Функция ПроверкаСинтаксиса(СтрокаПодключения = Неопределено,
		Режимы = Неопределено,
		Цели = Неопределено,
		ПутьОтчета = Неопределено,
		ФайлИсключений = Неопределено,
		ГруппироватьПоМетаданным = Ложь) Экспорт
	
	Шаблон = "vrunner validate syntax-check%1%2%3%4%5%6";

	Возврат СтрШаблон(Шаблон,
		Опция("--ibconnection", СтрокаПодключения),
		ОпцииСписком("--mode", Режимы),
		ОпцииСписком("--target", Цели),
		?(ПутьОтчета = Неопределено, "", " --report-format junit --report-path " + ПутьОтчета),
		Опция("--exception-file", ФайлИсключений),
		ФлагОпции("--groupbymetadata", ГруппироватьПоМетаданным));

КонецФункции

// vrunner validate edt [--src <КаталогИсходников>] [--report-format junit --report-path <ПутьОтчета>]
//		[--min-severity <МинимальнаяВажность>]
//
// Параметры:
//   КаталогИсходников - Строка - проект 1С:EDT, XML-выгрузка или файл .cf/.cfe
//   ПутьОтчета - Строка - путь к JUnit-отчёту
//   МинимальнаяВажность - Строка - critical, major, minor или none (--min-severity)
//
//  Возвращаемое значение:
//   Строка - 
//
Функция ВалидацияЕДТ(КаталогИсходников = Неопределено,
		ПутьОтчета = Неопределено,
		МинимальнаяВажность = Неопределено) Экспорт
	
	Шаблон = "vrunner validate edt%1%2%3";

	Возврат СтрШаблон(Шаблон,
		Опция("--src", КаталогИсходников),
		?(ПутьОтчета = Неопределено, "", " --report-format junit --report-path " + ПутьОтчета),
		Опция("--min-severity", МинимальнаяВажность));

КонецФункции
