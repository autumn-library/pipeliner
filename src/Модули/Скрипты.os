Функция КонвертироватьФорматИсходниковРасширения(КаталогИсходников, КаталогРезультата) Экспорт
	
	Шаблон = "vrunner cfe convert -s %1 %2";

	Возврат СтрШаблон(Шаблон, КаталогИсходников, КаталогРезультата);

КонецФункции

