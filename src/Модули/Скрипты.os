
// oscript -c <КодСкрипта> [Параметры]
//
// Параметры:
//   Скрипт - Строка - Выполняемый код
//   Параметры - Массив Из Строка - Аргументы командной строки
//
//  Возвращаемое значение:
//   Строка - Команда выполнения скрипта
//
Функция ВыполнитьСкриптИзСтроки(Скрипт, Параметры = Неопределено) Экспорт

	Если Параметры = Неопределено Тогда
		Параметры = Новый Массив();
	КонецЕсли;

	Шаблон = "oscript -c ""%1"" %2";

	Возврат СтрШаблон(Шаблон,
		Скрипт,
		СтрСоединить(Параметры, " "));

КонецФункции

// Генерация файла скрипта, который будет доступен
// к выполнению в пайплайне
//
// Параметры:
//   Скрипт - Строка - 
//   ИмяФайла - Строка -
//
//  Возвращаемое значение:
//   Строка - Файл скрипт, который будет выполнен в пайплайне
//
Функция ГенерацияОСкриптЛинукс(Скрипт, ИмяФайла) Экспорт

	Шаблон = "cat << 'EOF' > %1	
			|%2
			|EOF";

	Возврат СтрШаблон(Шаблон, ИмяФайла, Скрипт);

КонецФункции

// oscript <ИмяФайла> [Параметры]
//
// Параметры:
//   ИмяФайла - Строка - 
//   Параметры - Массив из Строка - 
//
//  Возвращаемое значение:
//   Строка -
//
Функция ВыполнитьОСкрипт(ИмяФайла, Параметры = Неопределено) Экспорт

	Если Параметры = Неопределено Тогда
		Параметры = Новый Массив();
	КонецЕсли;

	Шаблон = "oscript %1 %2";

	Возврат СтрШаблон(Шаблон,
		ИмяФайла,
		СтрСоединить(Параметры, " "));

КонецФункции

// echo "-- $(date '+%Y-%m-%d %H:%M:%S')" <ТекстСообщения>
//
// Параметры:
//   ТекстСообщения - Строка - Например: "Сборка конфигурации"
//  Возвращаемое значение:
//   Строка - 
//
Функция ЛогЭхоЛинукс(ТекстСообщения = "") Экспорт
	Возврат "echo ""-- $(date '+%Y-%m-%d %H:%M:%S')"" " + ТекстСообщения;
КонецФункции

// Вспомогательная: строка " --имя значение", если значение задано, иначе пустая строка
//
// Параметры:
//   ИмяОпции - Строка - имя опции, например: --ibconnection
//   Значение - Строка - значение опции
//
//  Возвращаемое значение:
//   Строка -
//
Функция Опция(ИмяОпции, Значение)
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Возврат " " + ИмяОпции + " " + Значение;
КонецФункции

// Вспомогательная: строка " --флаг", если флаг установлен, иначе пустая строка
//
// Параметры:
//   ИмяОпции - Строка - имя флага, например: --ibcmd
//   Флаг - Булево - признак установки
//
//  Возвращаемое значение:
//   Строка -
//
Функция ФлагОпции(ИмяОпции, Флаг)
	Возврат ?(Флаг, " " + ИмяОпции, "");
КонецФункции

// Вспомогательная: строка " --имя true|false", если булево значение задано, иначе пустая строка
//
// Параметры:
//   ИмяОпции - Строка - имя опции, например: --safe-mode
//   Значение - Булево - значение опции
//
//  Возвращаемое значение:
//   Строка -
//
Функция ОпцияБулево(ИмяОпции, Значение)
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Возврат " " + ИмяОпции + " " + ?(Значение, "true", "false");
КонецФункции

// Вспомогательная: повторяемая опция " --имя значение" для массива значений
//
// Параметры:
//   ИмяОпции - Строка - имя опции, например: --mode
//   Значения - Массив из Строка - список значений
//
//  Возвращаемое значение:
//   Строка -
//
Функция ОпцииСписком(ИмяОпции, Значения)
	Если Значения = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Результат = "";
	Для Каждого Значение Из Значения Цикл
		Результат = Результат + " " + ИмяОпции + " " + Значение;
	КонецЦикла;

	Возврат Результат;
КонецФункции

// Вспомогательная: набор опций EDT (--edt-workspace, --src-format, --edt-path,
// --edt-version, --edt-timeout, --edt-vmargs) для команд с исходниками 1С:EDT
//
// Параметры:
//   КаталогВоркспейсаЕДТ - Строка - каталог рабочей области EDT (--edt-workspace)
//   ФорматИсходников - Строка - auto, edt или xml (--src-format)
//   ПутьКЕДТ - Строка - путь к 1cedtcli (--edt-path)
//   ВерсияЕДТ - Строка - версия EDT (--edt-version)
//   ТаймаутЕДТВСек - Число - таймаут операций 1cedtcli (--edt-timeout)
//   ПамятьВГБ - Число - память для JVM (--edt-vmargs=-Xmx<ПамятьВГБ>g)
//
//  Возвращаемое значение:
//   Строка -
//
Функция ОпцииЕДТ(КаталогВоркспейсаЕДТ, ФорматИсходников, ПутьКЕДТ,
		ВерсияЕДТ, ТаймаутЕДТВСек, ПамятьВГБ)

	Возврат Опция("--edt-workspace", КаталогВоркспейсаЕДТ)
		+ Опция("--src-format", ФорматИсходников)
		+ Опция("--edt-path", ПутьКЕДТ)
		+ Опция("--edt-version", ВерсияЕДТ)
		+ ?(ТаймаутЕДТВСек = Неопределено, "", " --edt-timeout " + Строка(ТаймаутЕДТВСек))
		+ ?(ПамятьВГБ = Неопределено, "", " --edt-vmargs=-Xmx" + Строка(ПамятьВГБ) + "g");

КонецФункции

// vrunner cf compile [--ibcmd] -s <КаталогИсходников> <ПутьКФайлу>
//
// Параметры:
//   КаталогИсходников - Строка - Например: build/cf
//   ПутьКФайлу - Строка - Например: build/conf.cf
//   ИспользоватьИбкмд - Булево - Флаг --ibcmd
//
//  Возвращаемое значение:
//   Строка - 
//
Функция СобратьКонфигурациюИзФайлов(КаталогИсходников,
		ПутьКФайлу,
		ИспользоватьИбкмд = Истина) Экспорт
	
	Шаблон = "vrunner cf compile%1 -s %2 %3";

	Возврат СтрШаблон(Шаблон,
		ФлагОпции("--ibcmd", ИспользоватьИбкмд),
		КаталогИсходников,
		ПутьКФайлу);

КонецФункции

// vrunner cf decompile [--ibcmd] [--cf-file <ПутьКФайлу>] [--ibconnection <СтрокаПодключения>] <КаталогИсходников>
//
// Параметры:
//   КаталогИсходников - Строка - каталог для выгрузки исходников
//   ПутьКФайлу - Строка - файл .cf; если не задан - выгрузка из базы
//   СтрокаПодключения - Строка - Например: /Fbuild/ib
//   ИспользоватьИбкмд - Булево - Флаг --ibcmd
//
//  Возвращаемое значение:
//   Строка - 
//
Функция РазобратьКонфигурациюВИсходники(КаталогИсходников,
		ПутьКФайлу = Неопределено,
		СтрокаПодключения = Неопределено,
		ИспользоватьИбкмд = Истина) Экспорт
	
	Шаблон = "vrunner cf decompile%1%2%3 %4";

	Возврат СтрШаблон(Шаблон,
		ФлагОпции("--ibcmd", ИспользоватьИбкмд),
		Опция("--cf-file", ПутьКФайлу),
		Опция("--ibconnection", СтрокаПодключения),
		КаталогИсходников);

КонецФункции

// vrunner cf load [--ibcmd] --ibconnection <СтрокаПодключения> <КаталогИсходников>
//
// Параметры:
//   СтрокаПодключения - Строка - Например: /Fbuild/ib
//   КаталогИсходников - Строка - Например: build/src
//   ИспользоватьИбкмд - Булево - Флаг --ibcmd
//
//  Возвращаемое значение:
//   Строка - 
//
Функция ЗагрузитьКонфигурациюИзФайлов(СтрокаПодключения,
		КаталогИсходников,
		ИспользоватьИбкмд = Истина) Экспорт
	
	Шаблон = "vrunner cf load%1 --ibconnection %2 %3";

	Возврат СтрШаблон(Шаблон,
		ФлагОпции("--ibcmd", ИспользоватьИбкмд),
		СтрокаПодключения,
		КаталогИсходников);

КонецФункции

// vrunner cf unload [--ibcmd] --ibconnection <СтрокаПодключения> <ПутьКФайлу>
//
// Параметры:
//   СтрокаПодключения - Строка - Например: /Fbuild/ib
//   ПутьКФайлу - Строка - Например: build/conf.cf
//   ИспользоватьИбкмд - Булево - Флаг --ibcmd
//
//  Возвращаемое значение:
//   Строка - 
//
Функция ВыгрузитьКонфигурациюВФайл(СтрокаПодключения,
		ПутьКФайлу,
		ИспользоватьИбкмд = Истина) Экспорт
	
	Шаблон = "vrunner cf unload%1 --ibconnection %2 %3";

	Возврат СтрШаблон(Шаблон,
		ФлагОпции("--ibcmd", ИспользоватьИбкмд),
		СтрокаПодключения,
		ПутьКФайлу);

КонецФункции

// vrunner cf make-dist --ibconnection <СтрокаПодключения> <ПутьКФайлу>
//
// Параметры:
//   СтрокаПодключения - Строка - Например: /Fbuild/ib
//   ПутьКФайлу - Строка - Например: build/1Cv8-dist.cf
//
//  Возвращаемое значение:
//   Строка - 
//
Функция СоздатьФайлПоставки(СтрокаПодключения, ПутьКФайлу) Экспорт
	
	Шаблон = "vrunner cf make-dist --ibconnection %1 %2";

	Возврат СтрШаблон(Шаблон, СтрокаПодключения, ПутьКФайлу);

КонецФункции

// vrunner cf merge -s <ФайлКонфигурации> --merge-settings <ФайлНастроекОбъединения>
//		[--enable-support] [--disable-support] [--force] --ibconnection <СтрокаПодключения>
//
// Параметры:
//   СтрокаПодключения - Строка - Например: /Fbuild/ib
//   ФайлКонфигурации - Строка - файл .cf для объединения
//   ФайлНастроекОбъединения - Строка - файл настроек объединения
//   ПоставитьНаПоддержку - Булево - Флаг --enable-support
//   СнятьСПоддержки - Булево - Флаг --disable-support
//   Принудительно - Булево - Флаг --force
//
//  Возвращаемое значение:
//   Строка - 
//
Функция ОбъединитьКонфигурацию(СтрокаПодключения,
		ФайлКонфигурации,
		ФайлНастроекОбъединения,
		ПоставитьНаПоддержку = Ложь,
		СнятьСПоддержки = Ложь,
		Принудительно = Ложь) Экспорт
	
	Шаблон = "vrunner cf merge -s %1 --merge-settings %2%3%4%5 --ibconnection %6";

	Возврат СтрШаблон(Шаблон,
		ФайлКонфигурации,
		ФайлНастроекОбъединения,
		ФлагОпции("--enable-support", ПоставитьНаПоддержку),
		ФлагОпции("--disable-support", СнятьСПоддержки),
		ФлагОпции("--force", Принудительно),
		СтрокаПодключения);

КонецФункции

// vrunner cf vendor-update -s <ФайлОбновления> [--update-settings <ФайлНастроекОбъединения>]
//		[--force] [--no-update-db] --ibconnection <СтрокаПодключения>
//
// Параметры:
//   СтрокаПодключения - Строка - Например: /Fbuild/ib
//   ФайлОбновления - Строка - файл .cfu или .cf поставщика
//   ФайлНастроекОбъединения - Строка - файл настроек объединения
//   Принудительно - Булево - Флаг --force
//   ОбновитьКонфигурациюБД - Булево - если Ложь - флаг --no-update-db
//
//  Возвращаемое значение:
//   Строка - 
//
Функция ОбновитьКонфигурациюНаПоддержке(СтрокаПодключения,
		ФайлОбновления,
		ФайлНастроекОбъединения = Неопределено,
		Принудительно = Ложь,
		ОбновитьКонфигурациюБД = Истина) Экспорт
	
	Шаблон = "vrunner cf vendor-update -s %1%2%3%4 --ibconnection %5";

	Возврат СтрШаблон(Шаблон,
		ФайлОбновления,
		Опция("--update-settings", ФайлНастроекОбъединения),
		ФлагОпции("--force", Принудительно),
		ФлагОпции("--no-update-db", Не ОбновитьКонфигурациюБД),
		СтрокаПодключения);

КонецФункции

// vrunner cf compare --second-cf <ВторойФайл> [--first-cf <ПервыйФайл>]
//		[--ibconnection <СтрокаПодключения>] [--report-dir <КаталогОтчета>]
//		[--report-type <ТипОтчета>] [--report-format <ФорматОтчета>]
//
// Параметры:
//   ВторойФайл - Строка - файл .cf, с которым сравниваем
//   ПервыйФайл - Строка - первый файл .cf; если не задан - конфигурация базы
//   СтрокаПодключения - Строка - Например: /Fbuild/ib
//   КаталогОтчета - Строка - каталог отчёта (по умолчанию текущий)
//   ТипОтчета - Строка - Full или Brief
//   ФорматОтчета - Строка - txt или mxl
//
//  Возвращаемое значение:
//   Строка - 
//
Функция СравнитьКонфигурацию(ВторойФайл,
		ПервыйФайл = Неопределено,
		СтрокаПодключения = Неопределено,
		КаталогОтчета = Неопределено,
		ТипОтчета = Неопределено,
		ФорматОтчета = Неопределено) Экспорт
	
	Шаблон = "vrunner cf compare --second-cf %1%2%3%4%5%6";

	Возврат СтрШаблон(Шаблон,
		ВторойФайл,
		Опция("--first-cf", ПервыйФайл),
		Опция("--ibconnection", СтрокаПодключения),
		Опция("--report-dir", КаталогОтчета),
		Опция("--report-type", ТипОтчета),
		Опция("--report-format", ФорматОтчета));

КонецФункции

// vrunner cf convert -s <КаталогЕДТ> [--edt-vmargs=-Xmx<ПамятьВГБ>g] <КаталогКонфигуратор>
//
// Параметры:
//   КаталогЕДТ - Строка - проект 1С:EDT, например: build/edt
//   КаталогКонфигуратор - Строка - каталог XML-дампа Конфигуратора, например: build/cf
//   ПамятьВГБ - Число - память для JVM утилиты 1cedtcli (--edt-vmargs=-Xmx<ПамятьВГБ>g)
//
//  Возвращаемое значение:
//   Строка - 
//
Функция КонвертацияЕДТВКонфигуратор(КаталогЕДТ,
		КаталогКонфигуратор,
		ПамятьВГБ = 8) Экспорт
	
	Память = " --edt-vmargs=-Xmx" + Строка(ПамятьВГБ) + "g";

	Шаблон = "vrunner cf convert -s %1%2 %3";

	Возврат СтрШаблон(Шаблон,
		КаталогЕДТ,
		Память,
		КаталогКонфигуратор);

КонецФункции

// vrunner cfe compile [--ibcmd] -s <КаталогИсходников> [--extension-name <ИмяРасширения>] <ПутьКФайлу>
//
// Параметры:
//   КаталогИсходников - Строка - Например: build/ext/src
//   ПутьКФайлу - Строка - Например: build/ext.cfe
//   ИмяРасширения - Строка - Например: YAXUNIT
//   ИспользоватьИбкмд - Булево - Флаг --ibcmd
//
//  Возвращаемое значение:
//   Строка - 
//
Функция СобратьРасширениеИзФайлов(КаталогИсходников,
		ПутьКФайлу,
		ИмяРасширения = Неопределено,
		ИспользоватьИбкмд = Истина) Экспорт
	
	Шаблон = "vrunner cfe compile%1 -s %2%3 %4";

	Возврат СтрШаблон(Шаблон,
		ФлагОпции("--ibcmd", ИспользоватьИбкмд),
		КаталогИсходников,
		Опция("--extension-name", ИмяРасширения),
		ПутьКФайлу);

КонецФункции

// vrunner cfe decompile [--ibcmd] --cfe-file <ПутьКФайлу> --extension-name <ИмяРасширения> <КаталогИсходников>
//
// Параметры:
//   ПутьКФайлу - Строка - файл .cfe
//   ИмяРасширения - Строка - Например: YAXUNIT
//   КаталогИсходников - Строка - каталог для выгрузки исходников
//   ИспользоватьИбкмд - Булево - Флаг --ibcmd
//
//  Возвращаемое значение:
//   Строка - 
//
Функция РазобратьРасширениеВИсходники(ПутьКФайлу,
		ИмяРасширения,
		КаталогИсходников,
		ИспользоватьИбкмд = Истина) Экспорт
	
	Шаблон = "vrunner cfe decompile%1 --cfe-file %2 --extension-name %3 %4";

	Возврат СтрШаблон(Шаблон,
		ФлагОпции("--ibcmd", ИспользоватьИбкмд),
		ПутьКФайлу,
		ИмяРасширения,
		КаталогИсходников);

КонецФункции

// vrunner cfe load [--ibcmd] --ibconnection <СтрокаПодключения> --extension-name <ИмяРасширения> <КаталогИсходников>
//
// Параметры:
//   СтрокаПодключения - Строка - Например: /Fbuild/ib
//   КаталогИсходников - Строка - Например: build/ext/src
//   ИмяРасширения - Строка - Например: YAXUNIT
//   ИспользоватьИбкмд - Булево - Флаг --ibcmd
//
//  Возвращаемое значение:
//   Строка - 
//
Функция ЗагрузитьРасширениеИзФайлов(СтрокаПодключения,
		КаталогИсходников,
		ИмяРасширения,
		ИспользоватьИбкмд = Истина) Экспорт
	
	Шаблон = "vrunner cfe load%1 --ibconnection %2 --extension-name %3 %4";

	Возврат СтрШаблон(Шаблон,
		ФлагОпции("--ibcmd", ИспользоватьИбкмд),
		СтрокаПодключения,
		ИмяРасширения,
		КаталогИсходников);

КонецФункции

// vrunner cfe unload [--ibcmd] --ibconnection <СтрокаПодключения> --extension-name <ИмяРасширения> <ПутьКФайлу>
//
// Параметры:
//   СтрокаПодключения - Строка - Например: /Fbuild/ib
//   ИмяРасширения - Строка - Например: YAXUNIT
//   ПутьКФайлу - Строка - Например: build/ext.cfe
//   ИспользоватьИбкмд - Булево - Флаг --ibcmd
//
//  Возвращаемое значение:
//   Строка - 
//
Функция ВыгрузитьРасширениеВФайл(СтрокаПодключения,
		ИмяРасширения,
		ПутьКФайлу,
		ИспользоватьИбкмд = Истина) Экспорт
	
	Шаблон = "vrunner cfe unload%1 --ibconnection %2 --extension-name %3 %4";

	Возврат СтрШаблон(Шаблон,
		ФлагОпции("--ibcmd", ИспользоватьИбкмд),
		СтрокаПодключения,
		ИмяРасширения,
		ПутьКФайлу);

КонецФункции

// vrunner cfe compare --extension-name <ИмяРасширения> --second-cfe <ВторойФайл>
//		[--first-cfe <ПервыйФайл>] [--ibconnection <СтрокаПодключения>]
//		[--report-dir <КаталогОтчета>] [--report-type <ТипОтчета>] [--report-format <ФорматОтчета>]
//
// Параметры:
//   ИмяРасширения - Строка - Например: YAXUNIT
//   ВторойФайл - Строка - файл .cfe, с которым сравниваем
//   ПервыйФайл - Строка - первый файл .cfe; если не задан - расширение из базы
//   СтрокаПодключения - Строка - Например: /Fbuild/ib
//   КаталогОтчета - Строка - каталог отчёта (по умолчанию текущий)
//   ТипОтчета - Строка - Full или Brief
//   ФорматОтчета - Строка - txt или mxl
//
//  Возвращаемое значение:
//   Строка - 
//
Функция СравнитьРасширение(ИмяРасширения,
		ВторойФайл,
		ПервыйФайл = Неопределено,
		СтрокаПодключения = Неопределено,
		КаталогОтчета = Неопределено,
		ТипОтчета = Неопределено,
		ФорматОтчета = Неопределено) Экспорт
	
	Шаблон = "vrunner cfe compare --extension-name %1 --second-cfe %2%3%4%5%6%7";

	Возврат СтрШаблон(Шаблон,
		ИмяРасширения,
		ВторойФайл,
		Опция("--first-cfe", ПервыйФайл),
		Опция("--ibconnection", СтрокаПодключения),
		Опция("--report-dir", КаталогОтчета),
		Опция("--report-type", ТипОтчета),
		Опция("--report-format", ФорматОтчета));

КонецФункции

// vrunner cfe convert -s <КаталогИсходников> <КаталогРезультата>
