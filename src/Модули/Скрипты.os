// vrunner infobase init [--ibcmd] --ibconnection <СтрокаПодключения>
//		[--src <ИсточникКонфигурации>] [--ext <Расширение> ...] [--recursive]
//		[--edt-workspace <КаталогВоркспейсаЕДТ>] [--src-format <ФорматИсходников>]
//		[--edt-path <ПутьКЕДТ>] [--edt-version <ВерсияЕДТ>]
//		[--edt-timeout <ТаймаутЕДТВСек>] [--edt-vmargs=-Xmx<ПамятьВГБ>g]
//
// Параметры:
//   СтрокаПодключения - Строка - Например: /Fbuild/ib
//   ИсточникКонфигурации - Строка - каталог исходников, файл .cf или .dt (--src)
//   Расширения - Массив из Строка - файлы .cfe или каталоги исходников (повторяемая опция --ext)
//   Рекурсивно - Булево - Флаг --recursive
//   ИспользоватьИбкмд - Булево - Флаг --ibcmd
//   КаталогВоркспейсаЕДТ - Строка - каталог рабочей области EDT (--edt-workspace)
//   ФорматИсходников - Строка - auto, edt или xml (--src-format)
//   ПутьКЕДТ - Строка - путь к 1cedtcli (--edt-path)
//   ВерсияЕДТ - Строка - версия EDT (--edt-version)
//   ТаймаутЕДТВСек - Число - таймаут операций 1cedtcli (--edt-timeout)
//   ПамятьВГБ - Число - память для JVM (--edt-vmargs=-Xmx<ПамятьВГБ>g)
//
//  Возвращаемое значение:
//   Строка - 
//
Функция СозданиеБазы(СтрокаПодключения,
		ИсточникКонфигурации = Неопределено,
		Расширения = Неопределено,
		Рекурсивно = Ложь,
		ИспользоватьИбкмд = Истина,
		КаталогВоркспейсаЕДТ = Неопределено,
		ФорматИсходников = Неопределено,
		ПутьКЕДТ = Неопределено,
		ВерсияЕДТ = Неопределено,
		ТаймаутЕДТВСек = Неопределено,
		ПамятьВГБ = Неопределено) Экспорт
	
	Шаблон = "vrunner infobase init%1 --ibconnection %2%3%4%5%6";

	Возврат СтрШаблон(Шаблон,
		ФлагОпции("--ibcmd", ИспользоватьИбкмд),
		СтрокаПодключения,
		Опция("--src", ИсточникКонфигурации),
		ОпцииСписком("--ext", Расширения),
		ФлагОпции("--recursive", Рекурсивно),
		ОпцииЕДТ(КаталогВоркспейсаЕДТ, ФорматИсходников, ПутьКЕДТ, ВерсияЕДТ, ТаймаутЕДТВСек, ПамятьВГБ));

КонецФункции

// vrunner infobase update [--ibcmd] --ibconnection <СтрокаПодключения>
