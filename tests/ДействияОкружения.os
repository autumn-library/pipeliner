&Тест
Процедура Допустимые_НаполняетсяИзМетодов() Экспорт

	Действия = Новый Массив();
	Действия.Добавить(ДействияОкружения.Запуск());
	Действия.Добавить(ДействияОкружения.Подготовка());
	Действия.Добавить(ДействияОкружения.Остановка());
	Действия.Добавить(ДействияОкружения.Проверка());
	Действия.Добавить(ДействияОкружения.Доступ());

	Допустимые = ДействияОкружения.Допустимые();

	Ожидаем.Что(Допустимые.Количество()).Равно(Действия.Количество());

	Для Каждого Действие Из Действия Цикл
		Ожидаем.Что(Допустимые.Найти(Действие) <> Неопределено).ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура Допустимые_БезДублей() Экспорт

	Допустимые = ДействияОкружения.Допустимые();

	Уникальные = Новый Соответствие();
	Для Каждого Значение Из Допустимые Цикл
		Уникальные.Вставить(Значение, Истина);
	КонецЦикла;

	Ожидаем.Что(Допустимые.Количество()).Равно(Уникальные.Количество());

КонецПроцедуры

#КонецОбласти
