&Тест
Процедура Допустимые_СодержитВсеВиды() Экспорт

	Виды = Новый Массив();
	Виды.Добавить(ВидыОтчетов.Доступность());
	Виды.Добавить(ВидыОтчетов.Аннотации());
	Виды.Добавить(ВидыОтчетов.ФаззингАПИ());
	Виды.Добавить(ВидыОтчетов.ПроизводительностьБраузера());
	Виды.Добавить(ВидыОтчетов.КачествоКода());
	Виды.Добавить(ВидыОтчетов.СканированиеКонтейнеров());
	Виды.Добавить(ВидыОтчетов.ФаззингПокрытия());
	Виды.Добавить(ВидыОтчетов.ЦиклонДХ());
	Виды.Добавить(ВидыОтчетов.ДАСТ());
	Виды.Добавить(ВидыОтчетов.СканированиеЗависимостей());
	Виды.Добавить(ВидыОтчетов.Дотенв());
	Виды.Добавить(ВидыОтчетов.Юнит());
	Виды.Добавить(ВидыОтчетов.НагрузочныеТесты());
	Виды.Добавить(ВидыОтчетов.Метрики());
	Виды.Добавить(ВидыОтчетов.Требования());
	Виды.Добавить(ВидыОтчетов.САРИФ());
	Виды.Добавить(ВидыОтчетов.САСТ());
	Виды.Добавить(ВидыОтчетов.ПоискСекретов());
	Виды.Добавить(ВидыОтчетов.Терраформ());

	Допустимые = ВидыОтчетов.Допустимые();

	Ожидаем.Что(Допустимые.Количество()).Равно(Виды.Количество());

	Для Каждого Вид Из Виды Цикл
		Ожидаем.Что(Допустимые.Найти(Вид) <> Неопределено).ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура Допустимые_БезДублей() Экспорт

	Допустимые = ВидыОтчетов.Допустимые();

	Уникальные = Новый Соответствие();
	Для Каждого Значение Из Допустимые Цикл
		Уникальные.Вставить(Значение, Истина);
	КонецЦикла;

	Ожидаем.Что(Допустимые.Количество()).Равно(Уникальные.Количество());

КонецПроцедуры

&Тест
Процедура ФорматыПокрытия_СодержитВсеФорматы() Экспорт

	Форматы = Новый Массив();
	Форматы.Добавить(ВидыОтчетов.Кобертура());
	Форматы.Добавить(ВидыОтчетов.Джакоко());
	Форматы.Добавить(ВидыОтчетов.ЛКов());
	Форматы.Добавить(ВидыОтчетов.СимплКов());

	ФорматыПокрытия = ВидыОтчетов.ФорматыПокрытия();

	Ожидаем.Что(ФорматыПокрытия.Количество()).Равно(Форматы.Количество());

	Для Каждого Формат Из Форматы Цикл
		Ожидаем.Что(ФорматыПокрытия.Найти(Формат) <> Неопределено).ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ФорматыПокрытия_БезДублей() Экспорт

	ФорматыПокрытия = ВидыОтчетов.ФорматыПокрытия();

	Уникальные = Новый Соответствие();
	Для Каждого Значение Из ФорматыПокрытия Цикл
		Уникальные.Вставить(Значение, Истина);
	КонецЦикла;

	Ожидаем.Что(ФорматыПокрытия.Количество()).Равно(Уникальные.Количество());

КонецПроцедуры

