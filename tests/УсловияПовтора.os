&Тест
Процедура Допустимые_СодержитВсеЛитералыМетодов() Экспорт

	Литералы = Новый Массив();
	Литералы.Добавить(УсловияПовтора.Всегда());
	Литералы.Добавить(УсловияПовтора.НеизвестныйСбой());
	Литералы.Добавить(УсловияПовтора.СбойСкрипта());
	Литералы.Добавить(УсловияПовтора.СбойАПИ());
	Литералы.Добавить(УсловияПовтора.ЗависаниеИлиТаймаут());
	Литералы.Добавить(УсловияПовтора.ОжиданиеРаннеров());
	Литералы.Добавить(УсловияПовтора.НетПодходящихРаннеров());
	Литералы.Добавить(УсловияПовтора.НетОбновленийПриЗапуске());
	Литералы.Добавить(УсловияПовтора.НетОбновленийПриОтмене());
	Литералы.Добавить(УсловияПовтора.СбойРаннера());
	Литералы.Добавить(УсловияПовтора.ОшибкаКонфигурацииРаннера());
	Литералы.Добавить(УсловияПовтора.СбойВнешнейЗависимостиРаннера());
	Литералы.Добавить(УсловияПовтора.РаннерПрерван());
	Литералы.Добавить(УсловияПовтора.РаннерНеПоддерживается());
	Литералы.Добавить(УсловияПовтора.ПросроченнаяЗадача());
	Литералы.Добавить(УсловияПовтора.ПревышеноВремяВыполнения());
	Литералы.Добавить(УсловияПовтора.ТаймаутСервераПриЗапуске());
	Литералы.Добавить(УсловияПовтора.ТаймаутСервераПриОтмене());
	Литералы.Добавить(УсловияПовтора.ЗадачаВАрхиве());
	Литералы.Добавить(УсловияПовтора.НеВыполненыПредпосылки());
	Литералы.Добавить(УсловияПовтора.СбойПланировщика());
	Литералы.Добавить(УсловияПовтора.НарушениеЦелостностиДанных());

	Допустимые = УсловияПовтора.Допустимые();

	Ожидаем.Что(Допустимые.Количество()).Равно(Литералы.Количество());

	Для Каждого Литерал Из Литералы Цикл
		Ожидаем.Что(Допустимые.Найти(Литерал) <> Неопределено).ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура Допустимые_БезДублей() Экспорт

	Допустимые = УсловияПовтора.Допустимые();

	Уникальные = Новый Соответствие();
	Для Каждого Значение Из Допустимые Цикл
		Уникальные.Вставить(Значение, Истина);
	КонецЦикла;

	Ожидаем.Что(Допустимые.Количество()).Равно(Уникальные.Количество());

КонецПроцедуры

#КонецОбласти
